# Copy this file to server/.env and fill in values to enable live AI.
# The API key is read server-side only and is never exposed to the browser.

# Your OpenAI API key. Leave unset to use scripted (offline) responses.
OPENAI_API_KEY=

# Optional: which chat model to use (default: gpt-4o-mini).
EASYELECT_AI_MODEL=gpt-4o-mini

# Optional: API port (default: 4000).
PORT=4000

# Bearer token for the external social/posts API (Live_Credentials).
# Read server-side only and never exposed to the browser or serialized in responses.
# Leave unset/empty to serve scripted fallback posts (offline mode).
LIVE_POSTS_BEARER_TOKEN=

# Optional: live-posts cache lifetime in seconds (default: 300).
# Clamped to the range [1, 86400]; falls back to 300 when unset, non-numeric, or out of range.
EASYELECT_POSTS_CACHE_TTL_SECONDS=300
